# Supabase project (local: values printed by `pnpm exec supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection, server only. Local: Supabase CLI DB. Production: Supabase pooler URL (Transaction mode).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: also allow everyone with an email in this domain, e.g. qazbot.kz
# ALLOWED_DOMAIN=

# Production: configure SMTP + magic link template in the Supabase dashboard (see README).

# Time zone used for "today", deadlines and overdue checks
# APP_TIMEZONE=Asia/Almaty

# AI assistant (OpenRouter). Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Default model when a person hasn't picked one (any id from the picker)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional monthly cap in USD for all assistant requests; the assistant stops when it's reached
# AI_MONTHLY_BUDGET_USD=50
# Public URL of the app, used in MCP setup snippets and OpenRouter attribution
# APP_URL=http://localhost:3000
