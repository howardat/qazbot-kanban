# Supabase project (local: values printed by `pnpm exec supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, server only: stores expense invoices in the private "invoices" Storage bucket (created on first upload).
# Local: SECRET_KEY from `supabase status -o env`. Production: Project settings > API keys > Secret keys.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, server only. Local: Supabase CLI DB. Production: Supabase pooler URL (Transaction mode).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: also allow everyone with an email in this domain, e.g. qazbot.kz
# ALLOWED_DOMAIN=

# Production: configure SMTP + magic link template in the Supabase dashboard (see README).

# Time zone used for "today", deadlines and overdue checks
# APP_TIMEZONE=Asia/Almaty

# AI assistant (OpenRouter). Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Default model when a person hasn't picked one (any id from the picker)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional monthly cap in USD for all assistant requests; the assistant stops when it's reached
# AI_MONTHLY_BUDGET_USD=50
# Public URL of the app, used in MCP setup snippets and OpenRouter attribution
# APP_URL=http://localhost:3000

# Encrypts personal OpenRouter keys in the database: 32 random bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECRETS_KEY=

# Assistant talk mode (speech in and out on OpenRouter, paid with the same keys). Defaults shown.
# VOICE_STT_MODEL=mistralai/voxtral-mini-transcribe-3-0
# VOICE_TTS_MODEL=microsoft/mai-voice-2.1-flash
# Voice ids depend on the TTS model; set these when you change it.
# VOICE_TTS_VOICE_EN=en-US-Harper:MAI-Voice-2.1-Flash
# VOICE_TTS_VOICE_RU=ru-RU-Masha:MAI-Voice-2.1-Flash
# Optional: Soniox real-time recognition for talk mode (team key, needs the Temporary API keys permission).
# When set, talk mode offers a switch between Soniox and OpenRouter and defaults to Soniox.
# SONIOX_API_KEY=
# SONIOX_STT_MODEL=stt-rt-v5
# SONIOX_TTS_MODEL=tts-rt-v2
# Any Soniox voice speaks every language; pick one in the Soniox Console (Text-to-speech > Voices).
# SONIOX_TTS_VOICE=Adrian
